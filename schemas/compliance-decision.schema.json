{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tad3.org/schemas/compliance-decision.schema.json",
  "title": "TAD3 internal investor compliance decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decision_id", "issuer_id", "asset", "subject_ref", "requested_action", "decision", "checks", "decided_by", "decided_at", "evidence_refs"],
  "properties": {
    "version": { "const": "1.0" },
    "decision_id": { "type": "string", "format": "uuid" },
    "supersedes_decision_id": { "type": "string", "format": "uuid" },
    "issuer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "asset": { "type": "string", "pattern": "^[A-Za-z0-9]{1,12}$" },
    "subject_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$" },
    "subject_account": { "$ref": "#/$defs/stellarAccount" },
    "requested_action": { "enum": ["authorize_trustline", "restrict_trustline", "restore_trustline", "review_transfer", "clawback"] },
    "decision": { "enum": ["approved", "rejected", "needs_review", "suspended"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "result"],
        "properties": {
          "type": { "enum": ["identity", "sanctions", "residency", "accreditation", "transfer_restriction", "ownership_limit", "tax_status", "other"] },
          "result": { "enum": ["pass", "fail", "not_applicable", "manual_review"] },
          "policy_ref": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "jurisdictions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$|^[A-Z]{2}-[A-Z0-9]{1,3}$|^EU$|^GLOBAL$" }
    },
    "decided_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "attestation_key_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "attestation_key_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "digest"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "transaction_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_passphrase", "operation_digest"],
      "properties": {
        "network_passphrase": { "type": "string", "minLength": 1 },
        "operation_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "approved" } }, "required": ["decision"] },
      "then": { "required": ["expires_at"] }
    }
  ],
  "$defs": {
    "stellarAccount": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" }
  }
}
